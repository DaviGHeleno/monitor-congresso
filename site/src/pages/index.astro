<script>
  // Mosaico: trocar a votação pinta de novo cada rosto.
  const CODIGOS = ["S", "N", "A", "O", "P", "-"];
  const opcoesEl = document.getElementById("m-opcoes");
  const escolha = document.getElementById("m-votacao") as HTMLSelectElement | null;
  if (escolha && opcoesEl) {
    const opcoes = JSON.parse(opcoesEl.textContent || "[]") as { codigos: string; href: string; titulo: string }[];
    const assentos = Array.from(document.querySelectorAll<HTMLElement>("#assentos .assento"));
    const link = document.getElementById("m-link") as HTMLAnchorElement;
    const contadores = Object.fromEntries(Array.from(document.querySelectorAll<HTMLElement>("#m-placar [data-c]")).map((b) => [b.dataset.c!, b]));
    escolha.addEventListener("change", () => {
      const o = opcoes[Number(escolha.value)];
      const conta: Record<string, number> = Object.fromEntries(CODIGOS.map((c) => [c, 0]));
      assentos.forEach((a, i) => {
        const c = o.codigos[i] ?? "-";
        conta[c]++;
        CODIGOS.forEach((x) => a.classList.toggle(`v-${x}`, x === c));
      });
      for (const [c, el] of Object.entries(contadores)) el.textContent = String(conta[c] ?? 0);
      link.href = o.href;
      link.textContent = o.titulo;
    });
  }

  // Abas dos dias de votação.
  const abas = Array.from(document.querySelectorAll<HTMLButtonElement>(".dias [role=tab]"));
  const paineis = Array.from(document.querySelectorAll<HTMLElement>("[data-painel]"));
  const ativar = (k: number, foco = false) => {
    abas.forEach((a, j) => { a.setAttribute("aria-selected", String(j === k)); a.tabIndex = j === k ? 0 : -1; });
    paineis.forEach((p, j) => (p.hidden = j !== k));
    if (foco) abas[k].focus();
  };
  abas.forEach((a, k) => {
    a.addEventListener("click", () => ativar(k));
    a.addEventListener("keydown", (e) => {
      const passo = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (passo) { e.preventDefault(); ativar((k + passo + abas.length) % abas.length, true); }
    });
  });
  if (abas.length) ativar(0);

  // Entrada das seções: título, texto e figura sobem em sequência, uma vez.
  document.documentElement.classList.add("js");
  const alvos = document.querySelectorAll<HTMLElement>("[data-entra]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add("entrou"); io.unobserve(e.target); }
    }, { rootMargin: "0px 0px -4% 0px" });
    alvos.forEach((el) => io.observe(el));
  } else {
    alvos.forEach((el) => el.classList.add("entrou"));
  }
</script>
<script type="application/json" id="m-opcoes" set:html={JSON.stringify(opcoes.map(({ codigos, href, titulo }) => ({ codigos, href, titulo })))} />
</body>
