---
import Base from "../../layouts/Base.astro";
import { historico, indice, projetos, todosDeputados, type Deputado } from "../../lib/dados";
import { CATEGORIA_PROJETO, data, idade, nomeRede, proposicao, url } from "../../lib/formato";

export function getStaticPaths() {
  return todosDeputados().map((d) => ({ params: { id: String(d.id) }, props: { d } }));
}

const { d } = Astro.props as { d: Deputado };
const votos = historico().get(d.id) ?? [];
const projs = projetos(d.id);
const contagem: Record<string, number> = {};
for (const v of votos) contagem[v.voto] = (contagem[v.voto] ?? 0) + 1;
const partidosNoPeriodo = [...new Set(votos.map((v) => v.partido).filter(Boolean))];
const anos = [...new Set(votos.map((v) => v.votacao.data.slice(0, 4)))].sort().reverse();

// Descrição: frase curta montada só com dados oficiais.
const p = d.perfil;
const fem = p?.sexo === "F";
const cargo = d.em_exercicio === false ? (fem ? "Foi deputada federal" : "Foi deputado federal") : (fem ? "Deputada federal" : "Deputado federal");
const formacao = [p?.escolaridade && `escolaridade ${p.escolaridade.toLowerCase()}`, p?.profissoes.length && `profissão declarada: ${p.profissoes.join(", ").toLowerCase()}`]
  .filter(Boolean).join("; ");
const frase = [
  `${cargo}${d.uf ? ` por ${d.uf}` : ""}${d.partido ? ` (${d.partido})` : ""} na legislatura 2023–2027.`,
  p?.nascimento && `Nasceu em ${data(p.nascimento)}${p.municipio_nascimento ? `, em ${p.municipio_nascimento}${p.uf_nascimento ? `/${p.uf_nascimento}` : ""}` : ""}.`,
  formacao && `${formacao.charAt(0).toUpperCase()}${formacao.slice(1)}.`,
].filter(Boolean).join(" ");
const gabinete = p?.gabinete
  ? [p.gabinete.nome && `Gabinete ${p.gabinete.nome}`, p.gabinete.predio && `Prédio ${p.gabinete.predio}`, p.gabinete.telefone && `Tel. (61) ${p.gabinete.telefone}`]
      .filter(Boolean).join(" · ")
  : null;

// Situação dos projetos (só quando o coletor já gravou a situação).
const comSituacao = projs.some((x) => x.categoria);
const porCategoria: Record<string, number> = { lei: 0, aprovado: 0, tramitacao: 0, encerrado: 0 };
for (const x of projs) if (x.categoria) porCategoria[x.categoria]++;
const primeiroAutor = projs.filter((x) => x.primeiro_autor).length;
const ordemCategoria = ["lei", "aprovado", "tramitacao", "encerrado"];
const projsOrdenados = comSituacao
  ? [...projs].sort((a, b) => ordemCategoria.indexOf(a.categoria ?? "tramitacao") - ordemCategoria.indexOf(b.categoria ?? "tramitacao")
      || (b.apresentacao ?? "").localeCompare(a.apresentacao ?? ""))
  : projs;

// Histórico compacto: [posição em votacoes-leve.json, voto, partido na data se diferente do atual].
// O texto das votações vem do arquivo compartilhado, baixado uma vez para todas as páginas de deputado.
const posicao = new Map(indice().map((i, n) => [i.id, n]));
const compacto = votos.map((v) => [posicao.get(v.votacao.id), v.voto, v.partido && v.partido !== d.partido ? v.partido : 0]);
---
<Base titulo={d.nome} descricao={`Votos e projetos de ${d.nome} (${d.partido ?? ""}-${d.uf ?? ""}) na Câmara dos Deputados.`} secao="deputados">
  <div class="migalha"><a href={url("/deputados/")}>Deputados</a> › {d.nome}</div>

  <div class="perfil">
    {d.foto && <img src={d.foto} alt={`Foto oficial de ${d.nome}`} width="96" height="128" loading="lazy" />}
    <div>
      <h1 style="margin-bottom:.2rem">{d.nome}</h1>
      <p class="subtitulo" style="margin:0">
        {[d.partido, d.uf].filter(Boolean).join(" · ")}
        {d.em_exercicio === false && " · Fora de exercício"}
      </p>
      {partidosNoPeriodo.length > 1 && (
        <p style="margin:.4rem 0 0;font-size:.9rem;color:var(--texto-2)">
          Votou por mais de um partido no período: {partidosNoPeriodo.join(", ")}.
        </p>
      )}
      {d.url && <p style="margin:.5rem 0 0"><a href={d.url} rel="noopener">Página oficial na Câmara ↗</a></p>}
    </div>
  </div>

  {p && (
    <section class="cartao descricao-deputado" aria-labelledby="t-sobre">
      <h2 id="t-sobre" style="margin-top:0">Sobre</h2>
      <p class="frase">{frase}</p>
      <dl class="ficha">
        {p.nome_civil && <><dt>Nome civil</dt><dd>{p.nome_civil}</dd></>}
        {p.nascimento && (
          <><dt>Nascimento</dt><dd>{[
            data(p.nascimento, true),
            p.falecimento ? "" : ` (${idade(p.nascimento)} anos)`,
            p.municipio_nascimento ? `, ${p.municipio_nascimento}${p.uf_nascimento ? ` (${p.uf_nascimento})` : ""}` : "",
          ].join("")}</dd></>
        )}
        {p.falecimento && <><dt>Falecimento</dt><dd>{data(p.falecimento, true)}</dd></>}
        {p.escolaridade && <><dt>Escolaridade</dt><dd>{p.escolaridade}</dd></>}
        {p.profissoes.length > 0 && <><dt>Profissões declaradas</dt><dd>{p.profissoes.join(", ")}</dd></>}
        {p.condicao_eleitoral && <><dt>Condição</dt><dd>{p.condicao_eleitoral}{p.situacao && ` · ${p.situacao}`}</dd></>}
        {gabinete && <><dt>Gabinete</dt><dd>{gabinete}</dd></>}
        {p.redes.length > 0 && (
          <><dt>Redes sociais</dt><dd>
            {p.redes.map((r, n) => <>{n > 0 && " · "}<a href={r} rel="noopener nofollow">{nomeRede(r)}</a></>)}
          </dd></>
        )}
      </dl>
      <p class="fonte">Dados declarados à Câmara dos Deputados.</p>
    </section>
  )}

  <h2>Votos registrados</h2>
  {votos.length === 0 ? <p>Nenhum voto nominal registrado no período.</p> : (
    <>
      <div class="numeros">
        <div class="numero"><b>{votos.length}</b><span>Votos</span></div>
        {Object.entries(contagem).sort((a, b) => b[1] - a[1]).map(([v, n]) => (
          <div class="numero"><b>{n}</b><span>{v}</span></div>
        ))}
      </div>
      <form class="filtros" onsubmit="return false">
        <label>Buscar<input type="search" id="h-texto" placeholder="Tema ou projeto" autocomplete="off" /></label>
        <label>Ano<select id="h-ano"><option value="">Todos</option>{anos.map((a) => <option>{a}</option>)}</select></label>
        <label>Voto<select id="h-voto"><option value="">Todos</option>{Object.keys(contagem).map((v) => <option>{v}</option>)}</select></label>
        <label class="check"><input type="checkbox" id="h-proc" /> Esconder procedimentais</label>
      </form>
      <p class="contagem" id="h-contagem" aria-live="polite">{votos.length} votos</p>
      <div class="tabela-rolagem">
        <table>
          <thead><tr><th>Data</th><th>Votação</th><th>Voto</th></tr></thead>
          <tbody id="h-corpo">
            <tr><td colspan="3">Carregando votos…</td></tr>
          </tbody>
        </table>
      </div>
      <p class="paginacao"><button type="button" id="h-mais" class="oculto">Mostrar mais</button></p>
      <script type="application/json" id="h-dados" set:html={JSON.stringify(compacto)} />
      <noscript><p class="aviso">Ative o JavaScript para ver a lista de votos.</p></noscript>
    </>
  )}

  <h2>Projetos apresentados</h2>
  <p class="subtitulo">Projetos de lei, de lei complementar, de emenda à Constituição, de decreto legislativo e de resolução apresentados desde fevereiro de 2023 em que é autor ou coautor. Situação atual segundo a Câmara.</p>
  {projs.length === 0 ? <p>Nenhum projeto encontrado.</p> : (
    <>
      {comSituacao && (
        <div class="numeros" role="group" aria-label="Projetos por situação">
          <div class="numero"><b>{projs.length.toLocaleString("pt-BR")}</b><span>Projetos ({primeiroAutor.toLocaleString("pt-BR")} como primeiro autor)</span></div>
          {ordemCategoria.map((c) => (
            <button type="button" class={`numero filtro-categoria cat-${c}`} data-categoria={c} title={CATEGORIA_PROJETO[c].descricao}>
              <b>{porCategoria[c].toLocaleString("pt-BR")}</b><span>{CATEGORIA_PROJETO[c].rotulo}</span>
            </button>
          ))}
        </div>
      )}
      <form class="filtros" onsubmit="return false">
        <label>Buscar<input type="search" id="p-texto" placeholder="Tema ou número" autocomplete="off" /></label>
        {comSituacao && (
          <label>Situação
            <select id="p-categoria">
              <option value="">Todas</option>
              {ordemCategoria.map((c) => <option value={c}>{CATEGORIA_PROJETO[c].rotulo}</option>)}
            </select>
          </label>
        )}
        {primeiroAutor > 0 && <label class="check"><input type="checkbox" id="p-primeiro" /> Só como primeiro autor</label>}
      </form>
      <p class="contagem" id="p-contagem" aria-live="polite">{projs.length.toLocaleString("pt-BR")} projetos</p>
      <ul class="lista-simples" id="p-lista">
        {projsOrdenados.map((x) => (
          <li class="projeto" data-categoria={x.categoria ?? ""} data-primeiro={x.primeiro_autor ? "1" : "0"}
              data-busca={[proposicao(x), `${x.sigla} ${x.numero}/${x.ano}`, `${x.sigla}${x.numero}`, x.ementa].filter(Boolean).join(" ").toLowerCase()}>
            <div class="projeto-topo">
              {x.url ? <a href={x.url} rel="noopener"><b>{proposicao(x)}</b></a> : <b>{proposicao(x)}</b>}
              {x.categoria && <span class={`etiqueta cat-${x.categoria}`}>{CATEGORIA_PROJETO[x.categoria].rotulo}</span>}
              {x.primeiro_autor === false && <span class="coautor">coautoria</span>}
            </div>
            {x.ementa && <div class="projeto-ementa">{x.ementa}</div>}
            {x.situacao && <div class="projeto-situacao">Situação: {x.situacao}{x.situacao_data && ` (desde ${data(x.situacao_data)})`}</div>}
          </li>
        ))}
      </ul>
      <p class="paginacao"><button type="button" id="p-mais" class="oculto">Mostrar mais</button></p>
    </>
  )}
</Base>

<script>
  // Projetos: filtros + "mostrar mais" (50 por vez).
  {
    const lista = document.getElementById("p-lista");
    if (lista) {
      const itens = Array.from(lista.querySelectorAll<HTMLLIElement>("li.projeto"));
      const texto = document.getElementById("p-texto") as HTMLInputElement;
      const cat = document.getElementById("p-categoria") as HTMLSelectElement | null;
      const primeiro = document.getElementById("p-primeiro") as HTMLInputElement | null;
      const contagem = document.getElementById("p-contagem")!;
      const mais = document.getElementById("p-mais")!;
      const botoes = Array.from(document.querySelectorAll<HTMLButtonElement>(".filtro-categoria"));
      const norm = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
      itens.forEach((li) => (li.dataset.busca = norm(li.dataset.busca ?? "")));
      let limite = 50;
      const aplicar = () => {
        const termos = norm(texto.value).split(/\s+/).filter(Boolean);
        const vis = itens.filter((li) => (!cat?.value || li.dataset.categoria === cat.value)
          && (!primeiro?.checked || li.dataset.primeiro === "1") && termos.every((t) => li.dataset.busca!.includes(t)));
        const mostrar = new Set(vis.slice(0, limite));
        itens.forEach((li) => li.classList.toggle("oculto", !mostrar.has(li)));
        contagem.textContent = vis.length === 1 ? "1 projeto" : `${vis.length.toLocaleString("pt-BR")} projetos`;
        mais.classList.toggle("oculto", vis.length <= limite);
        mais.textContent = `Mostrar mais (${(vis.length - limite).toLocaleString("pt-BR")} restantes)`;
        botoes.forEach((b) => b.setAttribute("aria-pressed", String(!!cat && b.dataset.categoria === cat.value)));
      };
      const reiniciar = () => { limite = 50; aplicar(); };
      texto.addEventListener("input", reiniciar);
      cat?.addEventListener("change", reiniciar);
      primeiro?.addEventListener("change", reiniciar);
      botoes.forEach((b) => b.addEventListener("click", () => {
        if (!cat) return;
        cat.value = cat.value === b.dataset.categoria ? "" : b.dataset.categoria!;
        reiniciar();
        document.getElementById("p-lista")!.scrollIntoView({ behavior: "smooth", block: "start" });
      }));
      mais.addEventListener("click", () => { limite += 150; aplicar(); });
      aplicar();
    }
  }

  type Leve = [string, string, string, string, string, string]; // id, data, descrição, proposição, tipo, ementa
  const CLASSE: Record<string, string> = { Sim: "sim", Não: "nao", Abstenção: "abst", Obstrução: "obst", "Artigo 17": "art17" };
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
  const POR_VEZ = 100;

  const corpo = document.getElementById("h-corpo");
  const dados = document.getElementById("h-dados");
  if (corpo && dados) iniciarHistorico(corpo, JSON.parse(dados.textContent || "[]"));

  async function iniciarHistorico(corpo: HTMLElement, compacto: [number, string, string | 0][]) {
    let leve: Leve[];
    try {
      leve = await (await fetch(`${BASE}/dados/votacoes-leve.json`)).json();
    } catch {
      corpo.innerHTML = '<tr><td colspan="3">Não foi possível carregar os votos. Recarregue a página.</td></tr>';
      return;
    }
    const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const dataBR = (iso: string) => iso.slice(0, 10).split("-").reverse().join("/");
    const linhas = compacto.map(([pos, voto, partido]) => {
      const [id, data, desc, prop, tipo, ementa] = leve[pos];
      return { id, data, desc, prop, tipo, voto, partido, busca: norm([prop, desc, ementa].join(" ")) };
    });

    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const f = { texto: $("h-texto"), ano: $("h-ano"), voto: $("h-voto"), proc: $("h-proc") };
    const contagem = document.getElementById("h-contagem")!;
    const mais = document.getElementById("h-mais")!;
    let limite = POR_VEZ;

    const desenhar = () => {
      const termos = norm(f.texto.value).split(/\s+/).filter(Boolean);
      const vis = linhas.filter((l) => (!f.ano.value || l.data.startsWith(f.ano.value))
        && (!f.voto.value || l.voto === f.voto.value) && (!f.proc.checked || l.tipo !== "procedimental")
        && termos.every((t) => l.busca.includes(t)));
      contagem.textContent = vis.length === 1 ? "1 voto" : `${vis.length.toLocaleString("pt-BR")} votos`;
      corpo.innerHTML = vis.slice(0, limite).map((l) => `<tr>
        <td style="white-space:nowrap">${dataBR(l.data)}</td>
        <td><a href="${BASE}/votacao/${l.id}/">${esc(l.desc)}</a>
          <div style="font-size:.82rem;color:var(--texto-2);margin-top:2px">${esc([l.prop, l.tipo === "merito" ? "Mérito" : "Procedimental",
            l.partido ? `votou como ${l.partido}` : ""].filter(Boolean).join(" · "))}</div></td>
        <td><span class="voto ${CLASSE[l.voto] ?? "outro"}">${esc(l.voto)}</span></td></tr>`).join("")
        || '<tr><td colspan="3">Nenhum voto com esses filtros.</td></tr>';
      mais.classList.toggle("oculto", vis.length <= limite);
      mais.textContent = `Mostrar mais (${(vis.length - limite).toLocaleString("pt-BR")} restantes)`;
    };
    const reiniciar = () => { limite = POR_VEZ; desenhar(); };
    f.texto.addEventListener("input", reiniciar);
    [f.ano, f.voto, f.proc].forEach((c) => c.addEventListener("change", reiniciar));
    mais.addEventListener("click", () => { limite += POR_VEZ * 3; desenhar(); });
    desenhar();
  }
</script>
